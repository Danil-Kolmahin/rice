// Set solid black background
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

font = "IBM Plex Mono 14";
margin_x = 20;
margin_y = 20;

prompt_sprite = Sprite();
loading_sprite = Sprite();

// --- LUKS Passphrase Prompt ---
fun password_callback(prompt, bullets) {
  // Clear loading indicator if visible
  loading_sprite.SetImage(Image(0, 0));

  // Render passphrase prompt in white (R=1, G=1, B=1, Alpha=1)
  prompt_img = Image.Text("Disk encryption passphrase:", 1, 1, 1, 1, font);
  prompt_sprite.SetImage(prompt_img);
  prompt_sprite.SetX(margin_x);
  prompt_sprite.SetY(margin_y);

  // Note: 'bullets' is ignored intentionally for invisible password entry
}
Plymouth.SetDisplayPasswordFunction(password_callback);

// --- "Loading..." Animated Dots ---
dots = ["...", "..", ".", ""];
frame_count = 0;

fun refresh_callback() {
  frame_count++;
  if (frame_count % 15 == 0) {
    idx = (frame_count / 15) % 4;
    loading_text = "Loading" + dots[idx];
    
    loading_img = Image.Text(loading_text, 1, 1, 1, 1, font);
    loading_sprite.SetImage(loading_img);
    loading_sprite.SetX(margin_x);
    loading_sprite.SetY(margin_y);
  }
}

fun normal_callback() {
  // Clear passphrase prompt once unlocked
  prompt_sprite.SetImage(Image(0, 0));
  
  // Start loading animation loop
  Plymouth.SetRefreshFunction(refresh_callback);
}
Plymouth.SetDisplayNormalFunction(normal_callback);
