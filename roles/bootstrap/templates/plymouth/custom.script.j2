// Set solid black background
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

font = "IBM Plex Mono 14";
margin_x = 0;
margin_y = 0;

prompt_sprite = Sprite();
loading_sprite = Sprite();

current_duration = 0.0;
current_progress = 0.0;
dots = ["...", "..", ".", ""];
frame_count = 0;

// --- LUKS Passphrase Prompt ---
fun password_callback(prompt, bullets) {
  // Hide loading text when asking for password
  loading_sprite.SetImage(Image(0, 0));

  prompt_img = Image.Text("Disk encryption passphrase:", 1, 1, 1, 1, font);
  prompt_sprite.SetImage(prompt_img);
  prompt_sprite.SetX(margin_x);
  prompt_sprite.SetY(margin_y);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

// --- Capture Duration & Progress ---
fun progress_callback(duration, progress) {
  current_duration = duration;
  current_progress = progress;
}
Plymouth.SetBootProgressFunction(progress_callback);

// Helper to format floating point seconds into "X.Ys"
fun format_time(seconds) {
  sec_int = Math.Int(seconds);
  tenths = Math.Int((seconds - sec_int) * 10);
  if (tenths < 0) tenths = 0;
  return sec_int + "." + tenths + "s";
}

// --- Screen Refresh ---
fun refresh_callback() {
  // FIX: Force-clear passphrase prompt sprite on every refresh to prevent text overlap
  prompt_sprite.SetImage(Image(0, 0));

  frame_count++;
  if (frame_count % 10 == 0) {
    idx = (frame_count / 10) % 4;

    // DYNAMIC ESTIMATE: Expected Total Time = Elapsed Time / Progress Ratio
    if (current_progress > 0.05) {
      expected_total = current_duration / current_progress;
    } else {
      expected_total = 8.0; // Default placeholder until systemd reports > 5% progress
    }

    time_curr_str = format_time(current_duration);
    time_exp_str  = format_time(expected_total);

    // Output format: "Loading...  [2.3s / 7.8s]"
    full_text = "Loading" + dots[idx] + "  [" + time_curr_str + " / " + time_exp_str + "]";

    loading_img = Image.Text(full_text, 1, 1, 1, 1, font);
    loading_sprite.SetImage(loading_img);
    loading_sprite.SetX(margin_x);
    loading_sprite.SetY(margin_y);
  }
}

fun normal_callback() {
  // Clear passphrase text immediately upon entering normal boot phase
  prompt_sprite.SetImage(Image(0, 0));
  Plymouth.SetRefreshFunction(refresh_callback);
}
Plymouth.SetDisplayNormalFunction(normal_callback);
