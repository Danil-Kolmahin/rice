// Set solid black background
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

font = "IBM Plex Mono 14";
margin_x = 0;
margin_y = 0;

// Set your typical/target boot time here in seconds
target_duration = 8.0;

prompt_sprite = Sprite();
loading_sprite = Sprite();

// --- LUKS Passphrase Prompt ---
fun password_callback(prompt, bullets) {
  loading_sprite.SetImage(Image(0, 0));

  prompt_img = Image.Text("Disk encryption passphrase:", 1, 1, 1, 1, font);
  prompt_sprite.SetImage(prompt_img);
  prompt_sprite.SetX(margin_x);
  prompt_sprite.SetY(margin_y);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

// --- Duration Tracking ---
current_duration = 0.0;
current_progress = 0.0;
dots = ["...", "..", ".", ""];
frame_count = 0;

// Plymouth passes elapsed seconds directly to this callback
fun progress_callback(duration, progress) {
  current_duration = duration;
  current_progress = progress;
}
Plymouth.SetBootProgressFunction(progress_callback);

// --- Screen Refresh ---
fun refresh_callback() {
  frame_count++;
  if (frame_count % 10 == 0) {
    idx = (frame_count / 10) % 4;

    // Format current duration to 1 decimal place
    seconds_int = Math.Int(current_duration);
    tenths = Math.Int((current_duration - seconds_int) * 10);
    time_str = seconds_int + "." + tenths + "s";

    // Build line: "Loading...          [3.4s / 8.0s]"
    full_text = "Loading" + dots[idx] + "  [" + time_str + " / " + current_progress + "s]";

    loading_img = Image.Text(full_text, 1, 1, 1, 1, font);
    loading_sprite.SetImage(loading_img);
    loading_sprite.SetX(margin_x);
    loading_sprite.SetY(margin_y);
  }
}

fun normal_callback() {
  prompt_sprite.SetImage(Image(0, 0));
  Plymouth.SetRefreshFunction(refresh_callback);
}
Plymouth.SetDisplayNormalFunction(normal_callback);
